     // zstd compression main module
     constexpr uint8_t c_parallel_huffman = (CORE_COUNT < 4) ? 2 : (CORE_COUNT < 6 ? 4 : 8);
     constexpr uint32_t c_freq_dwidth = maxBitsUsed(BLOCK_SIZE);
